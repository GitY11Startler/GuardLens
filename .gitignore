# Environment & secrets
.venv/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data, models, raw predictions (never committed). The leading "/" anchors to the repo root:
# an unanchored "data/" also ignored the source package src/guardlens/data/.
/data/
/models/
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf
*.faiss
results/raw/
results/**/predictions*.jsonl
# Per-run folders (config, latency, cost) are machine-specific; committed copies would block
# `gl eval` in a fresh clone. Summaries, figures and the error analysis stay committed.
/results/runs/
